{
	"name": "obsidian-activity-calendar",
	"version": "1.0.0",
	"description": "A sidebar calendar plugin for Obsidian that lets you create and navigate periodic notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [],
	"license": "MIT",
	"packageManager": "pnpm@9.15.4",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^25.4.0",
		"esbuild": "0.27.3",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "17.4.0",
		"jiti": "2.6.1",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.57.0",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
